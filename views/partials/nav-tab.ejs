<a href="/tabs/<%= tab.id %>" class="tab-drop-zone flex items-center gap-1.5 whitespace-nowrap rounded-md px-2.5 py-1.5 font-medium <%= currentTabId == tab.id ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>" data-tab-id="<%= tab.id %>" draggable="true" title="Drag onto another tab to group under it">
  <% if (depth > 0) { %><span class="text-slate-400 dark:text-slate-500">↳</span><% } %>
  <% if (tab.color === 'indigo') { %><span class="inline-block h-2 w-2 rounded-full bg-indigo-500"></span><% } else if (tab.color === 'emerald') { %><span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span><% } else if (tab.color === 'rose') { %><span class="inline-block h-2 w-2 rounded-full bg-rose-500"></span><% } else if (tab.color === 'amber') { %><span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span><% } else if (tab.color === 'sky') { %><span class="inline-block h-2 w-2 rounded-full bg-sky-500"></span><% } else { %><span class="inline-block h-2 w-2 rounded-full bg-violet-500"></span><% } %>
  <%= tab.name %>
</a>
<% tab.children.forEach(child => { %><%- include('nav-tab', { tab: child, depth: depth + 1 }) %><% }) %>
