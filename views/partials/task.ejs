<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900" data-task-id="<%= task.id %>">
  <div class="flex items-start gap-3">
    <form method="post" action="/tasks/<%= task.id %>/toggle" class="auto-submit mt-0.5">
      <input type="checkbox" <%= task.done ? 'checked' : '' %> class="h-5 w-5 cursor-pointer rounded accent-indigo-600" title="Mark <%= task.done ? 'open' : 'done' %>">
    </form>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="break-words font-medium <%= task.done ? 'text-slate-400 line-through dark:text-slate-500' : 'text-slate-900 dark:text-slate-100' %>"><%= task.title %></span>
        <% if (task.subtotal > 0) { %>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= task.subdone %>/<%= task.subtotal %> subtasks</span>
        <% } %>
        <% if (task.startLabel) { %>
          <span class="rounded-full px-2 py-0.5 text-xs font-medium bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300">▶ <%= task.startLabel %></span>
        <% } %>
        <% if (task.dueLabel) { %>
          <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= task.overdue ? 'bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300' : 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300' %>">📅 <%= task.dueLabel %></span>
        <% } %>
      </div>
      <% if (task.notes) { %><p class="mt-1 whitespace-pre-wrap text-sm text-slate-500 dark:text-slate-400"><%= task.notes %></p><% } %>
    </div>
    <div class="flex shrink-0 items-center gap-1">
      <details class="relative">
        <summary class="cursor-pointer list-none rounded-lg px-2 py-1.5 text-sm text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300" title="Set start / due dates">🕒</summary>
        <form method="post" action="/tasks/<%= task.id %>/schedule" class="absolute right-0 top-full z-10 mt-1 flex flex-col gap-1.5 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-800">
          <label class="text-[10px] font-medium uppercase tracking-wide text-slate-400">Start</label>
          <input type="datetime-local" name="start" value="<%= inputValue(task.start_at, task.tz_offset) %>" class="rounded border border-slate-300 px-2 py-1 text-xs dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
          <label class="text-[10px] font-medium uppercase tracking-wide text-slate-400">Due</label>
          <input type="datetime-local" name="due" value="<%= inputValue(task.due_at, task.tz_offset) %>" class="rounded border border-slate-300 px-2 py-1 text-xs dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
          <input type="hidden" class="tz-offset" name="tz_offset" value="0">
          <button class="rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white hover:bg-indigo-700">Save</button>
        </form>
      </details>
      <details class="relative">
        <summary class="cursor-pointer list-none rounded-lg px-2 py-1.5 text-sm text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300" title="Add subtask">＋</summary>
        <form method="post" action="/tasks/<%= task.id %>/subtask" class="absolute right-0 top-full z-10 mt-1 flex gap-2 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-800">
          <input type="text" name="title" maxlength="200" required placeholder="Subtask…" class="rounded border border-slate-300 px-2 py-1 text-xs dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100">
          <input type="hidden" class="tz-offset" name="tz_offset" value="0">
          <button class="rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white hover:bg-indigo-700">Add</button>
        </form>
      </details>
      <form method="post" action="/tasks/<%= task.id %>/delete" data-confirm="Delete this task<% if (task.subtotal) { %> and its subtasks<% } %>?">
        <button class="rounded-lg px-2 py-1.5 text-sm text-slate-300 hover:bg-red-50 hover:text-red-500 dark:text-slate-600 dark:hover:bg-red-950 dark:hover:text-red-400" title="Delete task">✕</button>
      </form>
    </div>
  </div>
  <% if (task.children.length) { %>
    <ul class="mt-3 space-y-2 border-l-2 border-slate-100 pl-4 dark:border-slate-800">
      <% task.children.forEach(child => { %><%- include('task', { task: child }) %><% }) %>
    </ul>
  <% } %>
</li>
