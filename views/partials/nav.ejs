<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
  <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-3">
    <a href="/home" class="text-lg font-bold text-indigo-600">📅 Planner</a>
    <nav class="flex items-center gap-1 overflow-x-auto text-sm">
      <a href="/home" class="tab-drop-zone whitespace-nowrap rounded-md px-2.5 py-1.5 font-medium <%= currentPath === '/home' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>" data-tab-id="" title="Drop a tab here to ungroup it">Home</a>
      <a href="/calendar" class="whitespace-nowrap rounded-md px-2.5 py-1.5 font-medium <%= currentPath === '/calendar' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800' %>">Calendar</a>
      <% tabTree.forEach(root => { %><%- include('nav-tab', { tab: root, depth: 0 }) %><% }) %>
    </nav>
    <div class="ml-auto flex items-center gap-3 text-sm text-slate-600 dark:text-slate-300">
      <span class="hidden max-w-[160px] truncate sm:inline"><%= user.name || user.email %></span>
      <form method="post" action="/theme">
        <input type="hidden" class="redirect-url" name="redirect" value="<%= currentPath %>">
        <button type="submit" class="rounded-md border border-slate-300 px-2.5 py-1.5 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800" title="Toggle dark mode"><%= theme === 'dark' ? '☀️' : '🌙' %></button>
      </form>
      <a href="/logout" class="whitespace-nowrap rounded-md border border-slate-300 px-2.5 py-1.5 font-medium hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Log out</a>
    </div>
  </div>
  <!-- hidden form used by tab drag & drop -->
  <form id="tab-parent-form" method="post" action="/tabs/move-parent" class="hidden">
    <input type="hidden" name="tab_id">
    <input type="hidden" name="parent_id">
  </form>
</header>
