<div class="tab-drop-zone cursor-grab rounded-2xl border border-slate-200 bg-white p-5 shadow-sm active:cursor-grabbing dark:border-slate-800 dark:bg-slate-900" data-tab-id="<%= tab.id %>" draggable="true" title="Drag onto another tab to group under it">
  <div class="flex items-center gap-2">
    <% if (tab.color === 'indigo') { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-indigo-500"></span><% } else if (tab.color === 'emerald') { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500"></span><% } else if (tab.color === 'rose') { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-rose-500"></span><% } else if (tab.color === 'amber') { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500"></span><% } else if (tab.color === 'sky') { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-sky-500"></span><% } else { %><span class="inline-block h-2.5 w-2.5 rounded-full bg-violet-500"></span><% } %>
    <a href="/tabs/<%= tab.id %>" class="min-w-0 flex-1 truncate font-semibold text-slate-900 hover:underline dark:text-white"><%= tab.name %></a>
    <form method="post" action="/tabs/<%= tab.id %>/delete" data-confirm="Delete tab “<%= tab.name %>” and all its tasks?">
      <button class="text-slate-300 hover:text-red-500 dark:text-slate-600 dark:hover:text-red-400" title="Delete tab">✕</button>
    </form>
  </div>
  <% if (tab.children.length) { %>
    <p class="mt-2 text-xs font-medium uppercase tracking-wide text-indigo-500"><%= tab.children.length %> <%= tab.children.length === 1 ? 'tab' : 'tabs' %> · Master tab</p>
  <% } %>
  <div class="mt-4 flex items-end justify-between text-sm">
    <span class="font-medium text-slate-900 dark:text-slate-100"><%= tab.done %> finished · <%= tab.total - tab.done %> to do</span>
    <span class="text-slate-400 dark:text-slate-500"><%= pct(tab.done, tab.total) %>%</span>
  </div>
  <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
    <div class="h-full rounded-full bg-indigo-500" style="width: <%= pct(tab.done, tab.total) %>%"></div>
  </div>
</div>