<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="mx-auto max-w-3xl px-4 pb-16">
  <div class="pt-4"><%- include('partials/flash') %></div>

  <header class="mt-6 flex flex-wrap items-center gap-3">
    <h1 class="flex items-center gap-2 text-2xl font-bold text-slate-900 dark:text-white">
      <% if (tab.color === 'indigo') { %><span class="inline-block h-3 w-3 rounded-full bg-indigo-500"></span><% } else if (tab.color === 'emerald') { %><span class="inline-block h-3 w-3 rounded-full bg-emerald-500"></span><% } else if (tab.color === 'rose') { %><span class="inline-block h-3 w-3 rounded-full bg-rose-500"></span><% } else if (tab.color === 'amber') { %><span class="inline-block h-3 w-3 rounded-full bg-amber-500"></span><% } else if (tab.color === 'sky') { %><span class="inline-block h-3 w-3 rounded-full bg-sky-500"></span><% } else { %><span class="inline-block h-3 w-3 rounded-full bg-violet-500"></span><% } %>
      <%= tab.name %>
    </h1>
    <span class="text-sm text-slate-500 dark:text-slate-400"><% if (children.length) { %><%= done %> finished · <%= total - done %> to do · <%= pct(done, total) %>%<% } else { %><%= done %>/<%= total %> done · <%= pct(done, total) %>%<% } %></span>
  </header>

  <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
    <div class="h-full rounded-full bg-indigo-500" style="width: <%= pct(done, total) %>%"></div>
  </div>

  <% if (parent) { %>
  <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
    <span>Part of group: <a href="/tabs/<%= parent.id %>" class="font-medium text-indigo-600 hover:underline"><%= parent.name %></a></span>
    <form method="post" action="/tabs/move-parent">
      <input type="hidden" name="tab_id" value="<%= tab.id %>">
      <input type="hidden" name="parent_id" value="">
      <button class="rounded-md border border-slate-300 px-2 py-0.5 text-xs font-medium hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">ungroup</button>
    </form>
  </div>
  <% } %>
  <% if (children.length) { %>
  <section class="mt-8">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Choose a tab</h2>
        <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">This master tab combines progress from every tab below.</p>
      </div>
      <span class="text-sm text-slate-400 dark:text-slate-500"><%= children.length %> <%= children.length === 1 ? 'tab' : 'tabs' %></span>
    </div>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <% children.forEach(child => { %><%- include('partials/tab-card', { tab: child }) %><% }) %>
    </div>
  </section>

  <% if (ownTotal) { %>
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <header class="flex items-center justify-between px-4 py-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tasks directly in this master tab</h2>
      <span class="text-xs text-slate-400"><%= ownDone %>/<%= ownTotal %> done</span>
    </header>
    <div class="px-3 pb-3">
      <ul class="space-y-2">
        <% tasks.forEach(task => { %><%- include('partials/task', { task: task }) %><% }) %>
      </ul>
    </div>
  </section>
  <% } %>
  <% } else { %>

  <!-- add task -->
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">New task</h2>
    <form method="post" action="/tabs/<%= tab.id %>/tasks" class="mt-3 space-y-3">
      <input type="text" name="title" maxlength="200" required placeholder="What needs to be done?" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
      <div class="flex flex-wrap items-center gap-3">
        <input type="datetime-local" name="start" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" title="Start date (optional — the task spans until its due date)">
        <input type="datetime-local" name="due" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" title="Due date (shown in the calendar, triggers reminders)">
        <input type="hidden" class="tz-offset" name="tz_offset" value="0">
        <button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Add task</button>
      </div>
      <input type="text" name="notes" maxlength="2000" placeholder="Notes (optional)" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100">
    </form>
  </section>

  <% if (!ownTotal) { %>
    <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">No tasks yet. Add your first task above.</div>
  <% } else { %>
    <section class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <header class="px-4 py-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Tasks</h2>
      </header>
      <div class="px-3 pb-3">
        <ul class="space-y-2">
          <% tasks.forEach(task => { %><%- include('partials/task', { task: task }) %><% }) %>
        </ul>
      </div>
    </section>
  <% } %>
  <% } %>
</main>
<%- include('partials/footer') %>
