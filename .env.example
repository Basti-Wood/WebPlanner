# Port the website is exposed on (host side)
APP_PORT=3000

# Public URL of the app (used for Google OAuth callback and links in emails).
# MUST be the URL you actually open in the browser, e.g. on a server:
#   BASE_URL=https://planner.bastiwood.com
BASE_URL=http://localhost:3000

# Long random string used to sign session cookies — CHANGE THIS!
SESSION_SECRET=change-me-to-a-long-random-string

# Reminders: how many hours before a deadline the email is sent
REMIND_HOURS=24

# How far before a deadline the calendar app itself shows an alert (ISO duration, e.g. P2D = 2 days)
CAL_REMIND_OFFSET=P2D

# When the daily deadline check runs (cron syntax, uses TZ below)
CRON_SCHEDULE=0 8 * * *

# Timezone used for the reminder schedule (e.g. Europe/Berlin).
# Due dates themselves are stored per-task using your browser's timezone.
TZ=UTC

# --- Google login (optional) -------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com
# Redirect URI to register there (must match BASE_URL exactly):
#   local:     http://localhost:3000/auth/google/callback
#   server:    https://planner.bastiwood.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email reminders (optional) ----------------------------------------
# If SMTP_HOST is empty, reminder emails are saved to ./data/outbox instead.
# Example for Gmail: use an "App password" as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Planner <noreply@yourdomain.com>
